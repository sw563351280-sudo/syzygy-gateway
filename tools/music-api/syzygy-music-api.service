[Unit]
Description=Syzygy NetEase music adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=syzygy
WorkingDirectory=/opt/syzygy/tools/music-api
Environment=NCM_SERVICE_PORT=3001
Environment=NODE_ENV=production
ExecStart=/usr/bin/node start.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
